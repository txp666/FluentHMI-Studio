# Official native Snap7, pinned by the submodule. Compatibility changes are
# applied to a build copy; the upstream checkout remains byte-for-byte intact.
set(SNAP7_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/third_party/snap7" CACHE PATH "Official Snap7 sources")
if(NOT EXISTS "${SNAP7_ROOT}/src/lib/snap7_libmain.cpp")
    message(FATAL_ERROR "Initialize Snap7: git submodule update --init --recursive")
endif()
find_package(Threads REQUIRED)
find_package(Git REQUIRED)
set(FHMI_SNAP7_SOURCE "${CMAKE_BINARY_DIR}/_deps/snap7-src")
file(GLOB_RECURSE SNAP7_ORIGINAL RELATIVE "${SNAP7_ROOT}" "${SNAP7_ROOT}/src/*.cpp" "${SNAP7_ROOT}/src/*.h")
foreach(source IN LISTS SNAP7_ORIGINAL)
    configure_file("${SNAP7_ROOT}/${source}" "${FHMI_SNAP7_SOURCE}/${source}" COPYONLY)
endforeach()
set(SNAP7_PATCHES snap7-connect-timeout.patch)
if(APPLE)
    list(PREPEND SNAP7_PATCHES snap7-macos.patch)
endif()
foreach(patch IN LISTS SNAP7_PATCHES)
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --unsafe-paths "--directory=${FHMI_SNAP7_SOURCE}"
        "${CMAKE_CURRENT_SOURCE_DIR}/patches/${patch}" WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot apply ${patch}: ${error}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/patches/${patch}")
endforeach()
set(SNAP7_SOURCES src/sys/snap_msgsock.cpp src/sys/snap_sysutils.cpp src/sys/snap_tcpsrvr.cpp src/sys/snap_threads.cpp
    src/core/s7_client.cpp src/core/s7_isotcp.cpp src/core/s7_partner.cpp src/core/s7_peer.cpp
    src/core/s7_server.cpp src/core/s7_text.cpp src/core/s7_micro_client.cpp src/lib/snap7_libmain.cpp)
list(TRANSFORM SNAP7_SOURCES PREPEND "${FHMI_SNAP7_SOURCE}/")
add_library(snap7 SHARED ${SNAP7_SOURCES})
set_target_properties(snap7 PROPERTIES AUTOMOC OFF VERSION 1.4.3 SOVERSION 1)
target_include_directories(snap7 PRIVATE "${FHMI_SNAP7_SOURCE}/src/sys" "${FHMI_SNAP7_SOURCE}/src/core" "${FHMI_SNAP7_SOURCE}/src/lib")
target_include_directories(snap7 INTERFACE "${SNAP7_ROOT}/release/wrappers/c-cpp")
target_link_libraries(snap7 PRIVATE Threads::Threads)
if(WIN32)
    target_compile_definitions(snap7 PRIVATE _CRT_SECURE_NO_WARNINGS _WINSOCK_DEPRECATED_NO_WARNINGS WIN32_LEAN_AND_MEAN)
    target_link_libraries(snap7 PRIVATE ws2_32 winmm)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_link_libraries(snap7 PRIVATE rt)
endif()
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/snap7-path-$<CONFIG>.txt" CONTENT "$<TARGET_FILE:snap7>\n")
