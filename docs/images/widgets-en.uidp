  "logic": {
    "soundEnabled": false,
    "points": [
      {
        "name": "temperature",
        "expression": "35.8"
      },
      {
        "name": "charge",
        "expression": "28"
      }
    ],
    "alarms": [
      {
        "id": "High temperature",
        "level": 3,
        "ackRequired": true,
        "condition": "T['temperature'] > 32",
        "text": "Check the cooling circuit"
      },
      {
        "id": "Battery warning",
        "level": 2,
        "ackRequired": true,
        "condition": "T['charge'] <= 40",
        "text": "Schedule charging"
      }
    ]
  }
