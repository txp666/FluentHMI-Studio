{
  "version": "1.0",
  "appName": "分页与控件风格",
  "canvas": {
    "width": 1050,
    "height": 700,
    "gridSize": 10
  },
  "serial": {
    "parser": "line",
    "parserConfig": {
      "separator": ","
    }
  },
  "widgets": [
    {
      "type": "Label",
      "id": "heading",
      "geometry": {
        "x": 20,
        "y": 16,
        "w": 1010,
        "h": 36
      },
      "properties": {
        "text": "分页与控件风格",
        "fontSize": 22,
        "bold": true
      }
    },
    {
      "type": "Label",
      "id": "intro",
      "geometry": {
        "x": 20,
        "y": 54,
        "w": 1010,
        "h": 28
      },
      "properties": {
        "text": "无需连接设备。预览中点击导航切页，点击按钮查看本地通知；选中控件可在属性区修改风格。",
        "fontSize": 12,
        "bold": false
      }
    },
