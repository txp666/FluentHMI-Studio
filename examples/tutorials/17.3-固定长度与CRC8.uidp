{
  "version": "1.3",
  "appName": "17.3 固定长度与CRC8",
  "canvas": {
    "width": 1120,
    "height": 768,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.3 固定长度与CRC8",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "1. 选左侧「预览运行」，点「运行预览」。先连接右侧模拟设备，再连接左侧上位机。",
        "fontSize": 13
      }
    },
    {
      "id": "lessonAction",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 84,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "2. 改左侧温度原码、增益或计数，点「组帧并发送」。右侧查看换算值，报文卡可试解析 CRC8。",
        "fontSize": 13
      }
    },
    {
      "id": "hmi",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 24,
        "y": 122,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "上位机 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39176,
        "defaultMode": "客户端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "device",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 568,
        "y": 122,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "模拟设备 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39176,
        "defaultMode": "服务端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "tempInput",
      "type": "LineEdit",
      "geometry": {
        "x": 24,
        "y": 326,
        "w": 170,
        "h": 36
      },
      "properties": {
        "title": "温度原码 (0.1 °C)",
        "text": "-125",
        "inputOnly": true
      }
    },
    {
      "id": "gainInput",
      "type": "LineEdit",
      "geometry": {
        "x": 204,
        "y": 326,
        "w": 168,
        "h": 36
      },
      "properties": {
        "title": "增益 float32",
        "text": "1.5",
        "inputOnly": true
      }
    },
    {
      "id": "totalInput",
      "type": "LineEdit",
      "geometry": {
        "x": 382,
        "y": 326,
        "w": 170,
        "h": 36
      },
      "properties": {
        "title": "累计计数",
        "text": "70000",
        "inputOnly": true
      }
    },
    {
      "id": "sendFixed",
      "type": "PushButton",
      "geometry": {
        "x": 24,
        "y": 374,
        "w": 180,
        "h": 36
      },
      "properties": {
        "text": "组帧并发送",
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "sendUseTemplateFields": true,
        "sendFrameFieldBindings": [
          {
            "field": "temp10",
            "inputId": "tempInput"
          },
          {
            "field": "gain",
            "inputId": "gainInput"
          },
          {
            "field": "total",
            "inputId": "totalInput"
          }
        ],
        "buttonStyle": "强调"
      }
    },
    {
      "id": "cycleFixed",
      "type": "PushButton",
      "geometry": {
        "x": 216,
        "y": 374,
        "w": 232,
        "h": 36
      },
      "properties": {
        "text": "按模板周期发送 · 500 ms",
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "sendUseTemplateFields": true,
        "sendFrameFieldBindings": [
          {
            "field": "temp10",
            "inputId": "tempInput"
          },
          {
            "field": "gain",
            "inputId": "gainInput"
          },
          {
            "field": "total",
            "inputId": "totalInput"
          }
        ],
        "sendIntervalMs": 500,
        "buttonStyle": "描边"
      }
    },
    {
      "id": "tempC",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 326,
        "w": 254,
        "h": 76
      },
      "properties": {
        "title": "温度换算",
        "value": "—",
        "unit": "°C",
        "decimals": "1",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "设备温度"
      }
    },
    {
      "id": "gain",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 326,
        "w": 260,
        "h": 76
      },
      "properties": {
        "title": "小端增益",
        "value": "—",
        "unit": "",
        "decimals": "2",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "设备增益"
      }
    },
    {
      "id": "total",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 416,
        "w": 254,
        "h": 76
      },
      "properties": {
        "title": "32 位计数",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "设备计数"
      }
    },
    {
      "id": "cmd",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 416,
        "w": 260,
        "h": 76
      },
      "properties": {
        "title": "命令默认值",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "命令字"
      }
    },
    {
      "id": "hmiLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 24,
        "y": 510,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "上位机收发报文",
        "sourceCardId": "hmi"
      }
    },
    {
      "id": "deviceLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 568,
        "y": 510,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "模拟设备收发报文",
        "sourceCardId": "device"
      }
    }
  ],
  "frameTemplates": {
    "sample-frame": {
      "name": "14 字节遥测帧",
      "parser": "hex",
      "parserConfig": {
        "header": "5A A5",
        "footer": "",
        "fixedLength": 14,
        "checksum": "CRC8",
        "checksumStart": 2,
        "fields": [
          [
            "cmd",
            0,
            1,
            "uint8"
          ],
          [
            "temp10",
            1,
            2,
            "int16",
            "大端(BE)"
          ],
          [
            "gain",
            3,
            4,
            "float32",
            "小端(LE)"
          ],
          [
            "total",
            7,
            4,
            "uint32",
            "大端(BE)"
          ]
        ],
        "sendDefaults": {
          "cmd": "33"
        },
        "sendRequiredFields": [
          "temp10",
          "gain",
          "total"
        ]
      },
      "sample": "5A A5 21 FF 83 00 00 C0 3F 00 01 11 70 E6"
    }
  },
  "logic": {
    "points": [
      {
        "name": "设备温度",
        "unit": "°C",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "temp10",
          "expression": "value * 0.1"
        }
      },
      {
        "name": "设备增益",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "gain"
        }
      },
      {
        "name": "设备计数",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "total"
        }
      },
      {
        "name": "命令字",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "cmd"
        }
      }
    ]
  }
}
