{
  "version": "1.3",
  "appName": "17.10 同连接多接收模板",
  "canvas": {
    "width": 1120,
    "height": 833,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.10 同连接多接收模板",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "1. 选左侧「预览运行」，点「运行预览」。先连接右侧模拟设备，再连接左侧上位机。",
        "fontSize": 13
      }
    },
    {
      "id": "lessonAction",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 84,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "2. 改右侧任意发送值，点「发送三种帧」，左侧查看读数。试启动周期后直接改值。",
        "fontSize": 13
      }
    },
    {
      "id": "hmi",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 24,
        "y": 122,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "上位机 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39182,
        "defaultMode": "客户端",
        "receiveFrameTemplateIds": [
          "speed",
          "temperature",
          "status"
        ]
      }
    },
    {
      "id": "device",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 568,
        "y": 122,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "模拟设备 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39182,
        "defaultMode": "服务端",
        "receiveFrameTemplateIds": [
          "speed",
          "temperature",
          "status"
        ]
      }
    },
    {
      "id": "rpm",
      "type": "NumericDisplay",
      "geometry": {
        "x": 24,
        "y": 358,
        "w": 258,
        "h": 70
      },
      "properties": {
        "title": "转速帧 · value",
        "value": "—",
        "unit": "rpm",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "收到的转速"
      }
    },
    {
      "id": "temperature",
      "type": "NumericDisplay",
      "geometry": {
        "x": 294,
        "y": 358,
        "w": 258,
        "h": 70
      },
      "properties": {
        "title": "温度帧 · value",
        "value": "—",
        "unit": "°C",
        "decimals": "1",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "收到的温度"
      }
    },
    {
      "id": "pressure",
      "type": "NumericDisplay",
      "geometry": {
        "x": 24,
        "y": 437,
        "w": 258,
        "h": 70
      },
      "properties": {
        "title": "压力状态帧 · value",
        "value": "—",
        "unit": "bar",
        "decimals": "2",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "收到的压力"
      }
    },
    {
      "id": "state",
      "type": "NumericDisplay",
      "geometry": {
        "x": 294,
        "y": 437,
        "w": 258,
        "h": 70
      },
      "properties": {
        "title": "压力状态帧 · state",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20,
        "displayStyle": "状态徽标",
        "displayFormat": "枚举",
        "textList": "0=停止|#64748b\n1=运行|#107c10\n2=故障|#d13438"
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "收到的状态码"
      }
    },
    {
      "id": "rpmInput",
      "type": "LineEdit",
      "geometry": {
        "x": 568,
        "y": 358,
        "w": 258,
        "h": 36
      },
      "properties": {
        "title": "转速（回车单发）",
        "text": "1800",
        "placeholderText": "按转速模板组帧",
        "inputOnly": false,
        "commandMode": "HEX",
        "commandTargetId": "device",
        "sendFrameTemplateId": "speed",
        "sendFrameField": "value",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true
      }
    },
    {
      "id": "sendA",
      "type": "PushButton",
      "geometry": {
        "x": 568,
        "y": 448,
        "w": 170,
        "h": 36
      },
      "properties": {
        "text": "发转速 · 定长",
        "commandMode": "HEX",
        "commandTargetId": "device",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "speed",
        "sendUseTemplateFields": true,
        "sendFrameFieldBindings": [
          {
            "field": "value",
            "inputId": "rpmInput"
          }
        ]
      }
    },
    {
      "id": "sendB",
      "type": "PushButton",
      "geometry": {
        "x": 747,
        "y": 448,
        "w": 170,
        "h": 36
      },
      "properties": {
        "text": "发温度 · 长度字段",
        "commandMode": "HEX",
        "commandTargetId": "device",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "temperature",
        "sendUseTemplateFields": true,
        "sendFrameFieldBindings": [
          {
            "field": "value",
            "inputId": "temperatureInput"
          }
        ]
      }
    },
    {
      "id": "sendC",
      "type": "PushButton",
      "geometry": {
        "x": 926,
        "y": 448,
        "w": 170,
        "h": 36
      },
      "properties": {
        "text": "发压力状态 · 帧尾",
        "commandMode": "HEX",
        "commandTargetId": "device",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "status",
        "sendUseTemplateFields": true,
        "sendFrameFieldBindings": [
          {
            "field": "state",
            "inputId": "stateInput"
          },
          {
            "field": "value",
            "inputId": "pressureInput"
          }
        ]
      }
    },
    {
      "id": "sendBatch",
      "type": "PushButton",
      "geometry": {
        "x": 568,
        "y": 492,
        "w": 258,
        "h": 36
      },
      "properties": {
        "text": "发送三种帧",
        "commandMode": "requiresSendConfiguration",
        "sendConfiguration": {
          "commandMode": "HEX",
          "commandTargetId": "device"
        },
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameSequence": [
          {
            "sendFrameTemplateId": "status",
            "sendFrameFieldBindings": [
              {
                "field": "state",
                "inputId": "stateInput"
              },
              {
                "field": "value",
                "inputId": "pressureInput"
              }
            ]
          },
          {
            "sendFrameTemplateId": "temperature",
            "sendFrameFieldBindings": [
              {
                "field": "value",
                "inputId": "temperatureInput"
              }
            ]
          },
          {
            "sendFrameTemplateId": "speed",
            "sendFrameFieldBindings": [
              {
                "field": "value",
                "inputId": "rpmInput"
              }
            ]
          }
        ],
        "buttonStyle": "强调"
      }
    },
    {
      "id": "sendBad",
      "type": "PushButton",
      "geometry": {
        "x": 568,
        "y": 570,
        "w": 258,
        "h": 36
      },
      "properties": {
        "text": "坏 CRC 后接正确帧",
        "commandMode": "HEX",
        "commandTargetId": "device",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "command": "A5 5A 20 02 03 E7 EA 9F 0D A5 5A 10 DC 05 FF",
        "dataType": "HEX字符串"
      }
    },
    {
      "id": "sendCycle",
      "type": "PushButton",
      "geometry": {
        "x": 838,
        "y": 492,
        "w": 258,
        "h": 36
      },
      "properties": {
        "text": "开始周期混发 · 1000 ms",
        "commandMode": "requiresSendConfiguration",
        "sendConfiguration": {
          "commandMode": "HEX",
          "commandTargetId": "device"
        },
        "sendIntervalMs": 1000,
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameSequence": [
          {
            "sendFrameTemplateId": "status",
            "sendFrameFieldBindings": [
              {
                "field": "state",
                "inputId": "stateInput"
              },
              {
                "field": "value",
                "inputId": "pressureInput"
              }
            ]
          },
          {
            "sendFrameTemplateId": "temperature",
            "sendFrameFieldBindings": [
              {
                "field": "value",
                "inputId": "temperatureInput"
              }
            ]
          },
          {
            "sendFrameTemplateId": "speed",
            "sendFrameFieldBindings": [
              {
                "field": "value",
                "inputId": "rpmInput"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cycleCheck",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 584,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "周期每轮读取当前输入，到「周期任务」可查看和停止。",
        "fontSize": 13
      }
    },
    {
      "id": "sendBadLength",
      "type": "PushButton",
      "geometry": {
        "x": 838,
        "y": 570,
        "w": 258,
        "h": 36
      },
      "properties": {
        "text": "错长度后接正确帧",
        "commandMode": "HEX",
        "commandTargetId": "device",
        "command": "A5 5A 20 F0 FF 83 AA 75 0D A5 5A 10 FC 08 72",
        "dataType": "HEX字符串"
      }
    },
    {
      "id": "hmiLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 24,
        "y": 621,
        "w": 528,
        "h": 188
      },
      "properties": {
        "title": "上位机收发报文",
        "sourceCardId": "hmi"
      }
    },
    {
      "id": "deviceLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 568,
        "y": 621,
        "w": 528,
        "h": 188
      },
      "properties": {
        "title": "模拟设备收发报文",
        "sourceCardId": "device"
      }
    },
    {
      "id": "receivedValues",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 329,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "接收结果 · 工程数据点",
        "fontSize": 13,
        "bold": true
      }
    },
    {
      "id": "sendValues",
      "type": "Label",
      "geometry": {
        "x": 568,
        "y": 329,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "发送值 · 模拟设备",
        "fontSize": 13,
        "bold": true
      }
    },
    {
      "id": "diagnosticSamples",
      "type": "Label",
      "geometry": {
        "x": 568,
        "y": 541,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "坏帧恢复 · 固定样例",
        "fontSize": 13,
        "bold": true
      }
    },
    {
      "id": "valueScales",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 530,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "温度原码 × 0.1 得到 °C，压力原码 × 0.01 得到 bar。",
        "fontSize": 13
      }
    },
    {
      "id": "monitorTip",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 557,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "工具栏「工程数据监视」可查看数值、来源和状态。",
        "fontSize": 13
      }
    },
    {
      "id": "temperatureInput",
      "type": "LineEdit",
      "geometry": {
        "x": 838,
        "y": 358,
        "w": 258,
        "h": 36
      },
      "properties": {
        "title": "温度原码",
        "text": "-125",
        "inputOnly": true
      }
    },
    {
      "id": "pressureInput",
      "type": "LineEdit",
      "geometry": {
        "x": 568,
        "y": 401,
        "w": 258,
        "h": 36
      },
      "properties": {
        "title": "压力原码",
        "text": "250",
        "inputOnly": true
      }
    },
    {
      "id": "stateInput",
      "type": "LineEdit",
      "geometry": {
        "x": 838,
        "y": 401,
        "w": 258,
        "h": 36
      },
      "properties": {
        "title": "状态（0停 / 1运行 / 2故障）",
        "text": "2",
        "inputOnly": true
      }
    }
  ],
  "frameTemplates": {
    "speed": {
      "name": "转速帧",
      "parser": "hex",
      "parserConfig": {
        "header": "A5 5A",
        "footer": "",
        "fixedLength": 6,
        "matchOffset": 2,
        "matchBytes": "10",
        "checksum": "CRC8",
        "checksumStart": 2,
        "fields": [
          [
            "value",
            1,
            2,
            "uint16",
            "小端(LE)"
          ]
        ],
        "sendRequiredFields": [
          "value"
        ]
      },
      "sample": "A5 5A 10 DC 05 FF"
    },
    "temperature": {
      "name": "温度帧",
      "parser": "hex",
      "parserConfig": {
        "header": "A5 5A",
        "footer": "0D",
        "lengthOffset": 3,
        "lengthSize": 1,
        "maxFrameLength": 64,
        "idleTimeout": 350,
        "lengthCovers": "数据",
        "matchOffset": 2,
        "matchBytes": "20",
        "checksum": "CRC16-Modbus",
        "checksumStart": 2,
        "checksumEndian": "小端(LE)",
        "fields": [
          [
            "value",
            2,
            2,
            "int16",
            "大端(BE)"
          ]
        ],
        "sendRequiredFields": [
          "value"
        ]
      },
      "sample": "A5 5A 20 02 FF 83 AA 75 0D"
    },
    "status": {
      "name": "压力状态帧",
      "parser": "hex",
      "parserConfig": {
        "header": "7E 7F",
        "footer": "0D 0A",
        "checksum": "异或",
        "checksumStart": 2,
        "fields": [
          [
            "state",
            0,
            1,
            "uint8"
          ],
          [
            "value",
            1,
            2,
            "uint16",
            "大端(BE)"
          ]
        ],
        "sendRequiredFields": [
          "state",
          "value"
        ]
      },
      "sample": "7E 7F 02 00 FA F8 0D 0A"
    }
  },
  "logic": {
    "points": [
      {
        "name": "收到的转速",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "hmi",
          "key": "speed.value"
        },
        "unit": "rpm"
      },
      {
        "name": "收到的温度",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "hmi",
          "key": "temperature.value",
          "expression": "value * 0.1"
        },
        "unit": "°C"
      },
      {
        "name": "收到的压力",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "hmi",
          "key": "status.value",
          "expression": "value * 0.01"
        },
        "unit": "bar"
      },
      {
        "name": "收到的状态码",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "hmi",
          "key": "status.state"
        }
      }
    ]
  }
}
