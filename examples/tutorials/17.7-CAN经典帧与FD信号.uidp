{
  "version": "1.3",
  "appName": "17.7 CAN经典帧与FD信号",
  "canvas": {
    "width": 1120,
    "height": 847,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.7 CAN经典帧与FD信号",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "已选虚拟 CAN，连接后发出的报文会回环接收。可试回车、周期发送、扩展帧和远程帧。",
        "fontSize": 13
      }
    },
    {
      "id": "can",
      "type": "CanConfigCard",
      "geometry": {
        "x": 24,
        "y": 96,
        "w": 528,
        "h": 250
      },
      "properties": {
        "title": "CAN 通道",
        "defaultAdapter": "虚拟 CAN",
        "canFd": true,
        "defaultBitrate": "500k",
        "defaultDataBitrate": "2M",
        "canSignals": "321 rpm : 0|16@1+ (1,0) [0|8000] \"rpm\"\n321 temp : 16|16@1- (0.1,0) [-100|150] \"°C\"\n321 ready : 32|1@1+ (1,0) [0|1] \"\""
      }
    },
    {
      "id": "rpmInput",
      "type": "LineEdit",
      "geometry": {
        "x": 568,
        "y": 102,
        "w": 528,
        "h": 36
      },
      "properties": {
        "title": "转速（回车）",
        "text": "1800",
        "inputOnly": false,
        "commandMode": "CAN",
        "commandTargetId": "can",
        "canId": "321",
        "commandTemplate": "rpm={value},temp=-35.2,ready=1",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true
      }
    },
    {
      "id": "sendClassic",
      "type": "PushButton",
      "geometry": {
        "x": 568,
        "y": 150,
        "w": 254,
        "h": 36
      },
      "properties": {
        "text": "发 0x321 标准帧",
        "commandMode": "CAN",
        "commandTargetId": "can",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "canId": "321",
        "command": "rpm=1500,temp=-35.2,ready=1"
      }
    },
    {
      "id": "sendFd",
      "type": "PushButton",
      "geometry": {
        "x": 836,
        "y": 150,
        "w": 260,
        "h": 36
      },
      "properties": {
        "text": "发 0x18FF0055 FD+BRS",
        "commandMode": "CAN",
        "commandTargetId": "can",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "canFd": true,
        "canBrs": true,
        "canId": "18FF0055",
        "command": "00 FA 01 02 03 04 05 06 07 08 09 0A",
        "dataType": "HEX字符串"
      }
    },
    {
      "id": "cycleCan",
      "type": "PushButton",
      "geometry": {
        "x": 568,
        "y": 198,
        "w": 254,
        "h": 36
      },
      "properties": {
        "text": "周期 0x321 · 500 ms",
        "commandMode": "CAN",
        "commandTargetId": "can",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "canId": "321",
        "command": "rpm=1500,temp=-35.2,ready=1",
        "sendIntervalMs": 500,
        "buttonStyle": "描边"
      }
    },
    {
      "id": "manualCan",
      "type": "DataSendCard",
      "geometry": {
        "x": 24,
        "y": 360,
        "w": 528,
        "h": 110
      },
      "properties": {
        "title": "手工发送 CAN 帧",
        "commandMode": "CAN",
        "commandTargetId": "can",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true
      }
    },
    {
      "id": "canExamples",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 473,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "可输入 321#R8 或 00000321#11223344",
        "fontSize": 13
      }
    },
    {
      "id": "canRpm",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 246,
        "w": 254,
        "h": 70
      },
      "properties": {
        "title": "Intel 转速",
        "value": "—",
        "unit": "rpm",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "can",
        "key": "rpm"
      }
    },
    {
      "id": "canTemp",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 246,
        "w": 260,
        "h": 70
      },
      "properties": {
        "title": "有符号温度",
        "value": "—",
        "unit": "°C",
        "decimals": "1",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "can",
        "key": "temp"
      }
    },
    {
      "id": "canReady",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 327,
        "w": 254,
        "h": 70
      },
      "properties": {
        "title": "bit 32 就绪",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20,
        "displayStyle": "状态徽标",
        "displayFormat": "枚举",
        "textList": "0=未就绪|#64748b\n1=就绪|#107c10"
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "can",
        "key": "ready"
      }
    },
    {
      "id": "fdPressure",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 327,
        "w": 260,
        "h": 70
      },
      "properties": {
        "title": "Motorola 大端压力",
        "value": "—",
        "unit": "bar",
        "decimals": "2",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "CAN信号",
        "sourceCardId": "can",
        "canId": "18FF0055",
        "canStartBit": 7,
        "canBitLength": 16,
        "canByteOrder": "Motorola MSB",
        "canFactor": 0.01
      }
    },
    {
      "id": "canLog",
      "type": "CanMonitor",
      "geometry": {
        "x": 24,
        "y": 510,
        "w": 1072,
        "h": 313
      },
      "properties": {
        "sourceCardId": "can",
        "displayMode": "滚动日志",
        "autoScroll": true,
        "maxMessages": 180,
        "showSignals": true
      }
    }
  ]
}
