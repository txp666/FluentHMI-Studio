{
  "version": "1.3",
  "appName": "17.7 CAN经典帧与FD信号",
  "canvas": {
    "width": 1120,
    "height": 875,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.7 CAN经典帧与FD信号",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "1. 选左侧「预览运行」，点「运行预览」。点左侧虚拟 CAN 的「连接」。",
        "fontSize": 13
      }
    },
    {
      "id": "lessonAction",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 84,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "2. 改右侧转速，再点「发 0x321 标准帧」或启动周期。回环读数和收发记录会同步更新。",
        "fontSize": 13
      }
    },
    {
      "id": "can",
      "type": "CanConfigCard",
      "geometry": {
        "x": 24,
        "y": 124,
        "w": 528,
        "h": 250
      },
      "properties": {
        "title": "CAN 通道",
        "defaultAdapter": "虚拟 CAN",
        "canFd": true,
        "defaultBitrate": "500k",
        "defaultDataBitrate": "2M",
        "canSignals": "321 rpm : 0|16@1+ (1,0) [0|8000] \"rpm\"\n321 temp : 16|16@1- (0.1,0) [-100|150] \"°C\"\n321 ready : 32|1@1+ (1,0) [0|1] \"\""
      }
    },
    {
      "id": "rpmInput",
      "type": "LineEdit",
      "geometry": {
        "x": 568,
        "y": 130,
        "w": 254,
        "h": 36
      },
      "properties": {
        "title": "转速（回车）",
        "text": "1800",
        "inputOnly": false,
        "commandMode": "CAN",
        "commandTargetId": "can",
        "canId": "321",
        "commandTemplate": "rpm={value},temp=-35.2,ready=1",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true
      }
    },
    {
      "id": "pressureInput",
      "type": "LineEdit",
      "geometry": {
        "x": 836,
        "y": 130,
        "w": 260,
        "h": 36
      },
      "properties": {
        "title": "压力原码（0.01 bar）",
        "text": "250",
        "inputOnly": true
      }
    },
    {
      "id": "sendClassic",
      "type": "PushButton",
      "geometry": {
        "x": 568,
        "y": 178,
        "w": 254,
        "h": 36
      },
      "properties": {
        "text": "发 0x321 标准帧",
        "commandMode": "CAN",
        "commandTargetId": "can",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "canId": "321",
        "commandTemplate": "rpm={rpm},temp=-35.2,ready=1",
        "commandInputs": [
          {
            "variable": "rpm",
            "inputId": "rpmInput",
            "dataType": "uint16"
          }
        ],
        "buttonStyle": "强调"
      }
    },
    {
      "id": "sendFd",
      "type": "PushButton",
      "geometry": {
        "x": 836,
        "y": 178,
        "w": 260,
        "h": 36
      },
      "properties": {
        "text": "发 0x18FF0055 FD+BRS",
        "commandMode": "CAN",
        "commandTargetId": "can",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "canFd": true,
        "canBrs": true,
        "canId": "18FF0055",
        "commandTemplate": "{pressure} 01 02 03 04 05 06 07 08 09 0A",
        "commandInputs": [
          {
            "variable": "pressure",
            "inputId": "pressureInput",
            "dataType": "uint16"
          }
        ]
      }
    },
    {
      "id": "cycleCan",
      "type": "PushButton",
      "geometry": {
        "x": 568,
        "y": 226,
        "w": 254,
        "h": 36
      },
      "properties": {
        "text": "周期 0x321 · 500 ms",
        "commandMode": "CAN",
        "commandTargetId": "can",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "canId": "321",
        "sendIntervalMs": 500,
        "buttonStyle": "描边",
        "commandTemplate": "rpm={rpm},temp=-35.2,ready=1",
        "commandInputs": [
          {
            "variable": "rpm",
            "inputId": "rpmInput",
            "dataType": "uint16"
          }
        ]
      }
    },
    {
      "id": "manualCan",
      "type": "DataSendCard",
      "geometry": {
        "x": 24,
        "y": 388,
        "w": 528,
        "h": 110
      },
      "properties": {
        "title": "手工发送 CAN 帧",
        "commandMode": "CAN",
        "commandTargetId": "can",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true
      }
    },
    {
      "id": "canExamples",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 501,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "手工试发：321#R8（远程帧）或 00000321#11223344（扩展帧）",
        "fontSize": 13
      }
    },
    {
      "id": "canFixedFields",
      "type": "Label",
      "geometry": {
        "x": 836,
        "y": 231,
        "w": 260,
        "h": 24
      },
      "properties": {
        "text": "标准帧预设 −35.2 °C / 就绪",
        "fontSize": 13
      }
    },
    {
      "id": "canRpm",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 274,
        "w": 254,
        "h": 70
      },
      "properties": {
        "title": "Intel 转速",
        "value": "—",
        "unit": "rpm",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "回环转速"
      }
    },
    {
      "id": "canTemp",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 274,
        "w": 260,
        "h": 70
      },
      "properties": {
        "title": "有符号温度",
        "value": "—",
        "unit": "°C",
        "decimals": "1",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "回环温度"
      }
    },
    {
      "id": "canReady",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 355,
        "w": 254,
        "h": 70
      },
      "properties": {
        "title": "bit 32 就绪",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20,
        "displayStyle": "状态徽标",
        "displayFormat": "枚举",
        "textList": "0=未就绪|#64748b\n1=就绪|#107c10"
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "回环就绪"
      }
    },
    {
      "id": "fdPressure",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 355,
        "w": 260,
        "h": 70
      },
      "properties": {
        "title": "Motorola 大端压力",
        "value": "—",
        "unit": "bar",
        "decimals": "2",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "回环压力"
      }
    },
    {
      "id": "canLog",
      "type": "CanMonitor",
      "geometry": {
        "x": 24,
        "y": 538,
        "w": 1072,
        "h": 313
      },
      "properties": {
        "sourceCardId": "can",
        "displayMode": "滚动日志",
        "autoScroll": true,
        "maxMessages": 180,
        "showSignals": true
      }
    }
  ],
  "logic": {
    "points": [
      {
        "name": "回环转速",
        "unit": "rpm",
        "binding": {
          "parseMode": "CAN 信号名称",
          "sourceCardId": "can",
          "key": "0x321.rpm"
        }
      },
      {
        "name": "回环温度",
        "unit": "°C",
        "binding": {
          "parseMode": "CAN 信号名称",
          "sourceCardId": "can",
          "key": "0x321.temp"
        }
      },
      {
        "name": "回环就绪",
        "binding": {
          "parseMode": "CAN 信号名称",
          "sourceCardId": "can",
          "key": "0x321.ready"
        }
      },
      {
        "name": "回环压力",
        "unit": "bar",
        "binding": {
          "parseMode": "CAN信号",
          "sourceCardId": "can",
          "canId": "18FF0055",
          "canStartBit": 7,
          "canBitLength": 16,
          "canByteOrder": "Motorola MSB",
          "canFactor": 0.01
        }
      }
    ]
  }
}
