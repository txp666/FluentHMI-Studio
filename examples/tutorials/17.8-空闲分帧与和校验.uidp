{
  "version": "1.3",
  "appName": "17.8 空闲分帧与和校验",
  "canvas": {
    "width": 1120,
    "height": 768,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.8 空闲分帧与和校验",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "1. 选左侧「预览运行」，点「运行预览」。先连接右侧模拟设备，再连接左侧上位机。",
        "fontSize": 13
      }
    },
    {
      "id": "lessonAction",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 84,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "2. 改左侧采样值并回车。空闲约 150 ms 后右侧出现读数，勾选「线路字节」可对比。",
        "fontSize": 13
      }
    },
    {
      "id": "hmi",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 24,
        "y": 122,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "上位机 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39180,
        "defaultMode": "客户端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "device",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 568,
        "y": 122,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "模拟设备 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39180,
        "defaultMode": "服务端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "readingInput",
      "type": "LineEdit",
      "geometry": {
        "x": 24,
        "y": 326,
        "w": 300,
        "h": 36
      },
      "properties": {
        "title": "采样值（回车）",
        "text": "-1234",
        "inputOnly": false,
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "sendFrameTemplateId": "sample-frame",
        "sendFrameField": "reading",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true
      }
    },
    {
      "id": "sendIdle",
      "type": "PushButton",
      "geometry": {
        "x": 338,
        "y": 326,
        "w": 214,
        "h": 36
      },
      "properties": {
        "text": "发送空闲分帧样例",
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "sendUseTemplateFields": true,
        "sendFrameFieldBindings": [
          {
            "field": "reading",
            "inputId": "readingInput"
          }
        ],
        "buttonStyle": "强调"
      }
    },
    {
      "id": "cycleIdle",
      "type": "PushButton",
      "geometry": {
        "x": 24,
        "y": 374,
        "w": 234,
        "h": 36
      },
      "properties": {
        "text": "周期采样 · 600 ms",
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "sendUseTemplateFields": true,
        "sendFrameFieldBindings": [
          {
            "field": "reading",
            "inputId": "readingInput"
          }
        ],
        "sendIntervalMs": 600,
        "buttonStyle": "描边"
      }
    },
    {
      "id": "idleReading",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 326,
        "w": 528,
        "h": 76
      },
      "properties": {
        "title": "空闲后交付的采样值",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "设备采样"
      }
    },
    {
      "id": "idleChannel",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 416,
        "w": 254,
        "h": 76
      },
      "properties": {
        "title": "默认通道",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "采样通道"
      }
    },
    {
      "id": "idleCommand",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 416,
        "w": 260,
        "h": 76
      },
      "properties": {
        "title": "默认命令",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "命令字"
      }
    },
    {
      "id": "hmiLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 24,
        "y": 510,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "上位机收发报文",
        "sourceCardId": "hmi"
      }
    },
    {
      "id": "deviceLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 568,
        "y": 510,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "模拟设备收发报文",
        "sourceCardId": "device"
      }
    }
  ],
  "frameTemplates": {
    "sample-frame": {
      "name": "150 ms 空闲采样",
      "parser": "hex",
      "parserConfig": {
        "header": "C3",
        "footer": "",
        "idleTimeout": 150,
        "checksum": "和校验",
        "checksumStart": 1,
        "fields": [
          [
            "command",
            0,
            1,
            "uint8"
          ],
          [
            "channel",
            1,
            1,
            "uint8"
          ],
          [
            "reading",
            2,
            2,
            "int16",
            "小端(LE)"
          ]
        ],
        "sendDefaults": {
          "command": "127",
          "channel": "5"
        },
        "sendRequiredFields": [
          "reading"
        ]
      },
      "sample": "C3 7F 05 2E FB AD"
    }
  },
  "logic": {
    "points": [
      {
        "name": "设备采样",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "reading"
        }
      },
      {
        "name": "采样通道",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "channel"
        }
      },
      {
        "name": "命令字",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "command"
        }
      }
    ]
  }
}
