{
  "version": "1.3",
  "appName": "17.8 空闲分帧与和校验",
  "canvas": {
    "width": 1120,
    "height": 740,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.8 空闲分帧与和校验",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "先连右侧，再连左侧。采样值可回车，周期按 600 ms 发送。勾上「线路字节」对比空闲交付。",
        "fontSize": 13
      }
    },
    {
      "id": "hmi",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 24,
        "y": 94,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "上位机 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39180,
        "defaultMode": "客户端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "device",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 568,
        "y": 94,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "模拟设备 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39180,
        "defaultMode": "服务端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "readingInput",
      "type": "LineEdit",
      "geometry": {
        "x": 24,
        "y": 298,
        "w": 300,
        "h": 36
      },
      "properties": {
        "title": "采样值（回车）",
        "text": "-1234",
        "inputOnly": false,
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "sendFrameTemplateId": "sample-frame",
        "sendFrameField": "reading",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true
      }
    },
    {
      "id": "sendIdle",
      "type": "PushButton",
      "geometry": {
        "x": 338,
        "y": 298,
        "w": 214,
        "h": 36
      },
      "properties": {
        "text": "发送空闲分帧样例",
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "sendUseTemplateFields": true,
        "sendFrameFieldBindings": [
          {
            "field": "reading",
            "inputId": "readingInput"
          }
        ]
      }
    },
    {
      "id": "cycleIdle",
      "type": "PushButton",
      "geometry": {
        "x": 24,
        "y": 346,
        "w": 234,
        "h": 36
      },
      "properties": {
        "text": "周期采样 · 600 ms",
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "sendUseTemplateFields": true,
        "sendFrameFieldBindings": [
          {
            "field": "reading",
            "inputId": "readingInput"
          }
        ],
        "sendIntervalMs": 600,
        "buttonStyle": "描边"
      }
    },
    {
      "id": "idleReading",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 298,
        "w": 528,
        "h": 76
      },
      "properties": {
        "title": "空闲后交付的采样值",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "device",
        "key": "reading"
      }
    },
    {
      "id": "idleChannel",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 388,
        "w": 254,
        "h": 76
      },
      "properties": {
        "title": "默认通道",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "device",
        "key": "channel"
      }
    },
    {
      "id": "idleCommand",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 388,
        "w": 260,
        "h": 76
      },
      "properties": {
        "title": "默认命令",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "device",
        "key": "command"
      }
    },
    {
      "id": "hmiLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 24,
        "y": 482,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "上位机收发报文",
        "sourceCardId": "hmi"
      }
    },
    {
      "id": "deviceLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 568,
        "y": 482,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "模拟设备收发报文",
        "sourceCardId": "device"
      }
    }
  ],
  "frameTemplates": {
    "sample-frame": {
      "name": "150 ms 空闲采样",
      "parser": "hex",
      "parserConfig": {
        "header": "C3",
        "footer": "",
        "idleTimeout": 150,
        "checksum": "和校验",
        "checksumStart": 1,
        "fields": [
          [
            "command",
            0,
            1,
            "uint8"
          ],
          [
            "channel",
            1,
            1,
            "uint8"
          ],
          [
            "reading",
            2,
            2,
            "int16",
            "小端(LE)"
          ]
        ],
        "sendDefaults": {
          "command": "127",
          "channel": "5"
        },
        "sendRequiredFields": [
          "reading"
        ]
      },
      "sample": "C3 7F 05 2E FB AD"
    }
  }
}
