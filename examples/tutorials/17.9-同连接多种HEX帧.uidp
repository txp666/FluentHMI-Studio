{
  "version": "1.3",
  "appName": "17.9 同连接多种HEX帧",
  "canvas": {
    "width": 1120,
    "height": 833,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.9 同连接多种HEX帧",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "1. 选左侧「预览运行」，点「运行预览」。先连接右侧模拟设备，再连接左侧上位机。",
        "fontSize": 13
      }
    },
    {
      "id": "lessonAction",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 84,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "2. 改右侧发送值，点击对应帧的按钮。左侧只有对应命令字的工程数据点更新。",
        "fontSize": 13
      }
    },
    {
      "id": "hmi",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 24,
        "y": 122,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "上位机 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39181,
        "defaultMode": "客户端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "device",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 568,
        "y": 122,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "模拟设备 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39181,
        "defaultMode": "服务端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "rpm",
      "type": "NumericDisplay",
      "geometry": {
        "x": 24,
        "y": 358,
        "w": 258,
        "h": 70
      },
      "properties": {
        "title": "0x10 · 转速",
        "value": "—",
        "unit": "rpm",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "收到的转速"
      }
    },
    {
      "id": "temperature",
      "type": "NumericDisplay",
      "geometry": {
        "x": 294,
        "y": 358,
        "w": 258,
        "h": 70
      },
      "properties": {
        "title": "0x30 · 温度",
        "value": "—",
        "unit": "°C",
        "decimals": "1",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "收到的温度"
      }
    },
    {
      "id": "pressure",
      "type": "NumericDisplay",
      "geometry": {
        "x": 24,
        "y": 437,
        "w": 258,
        "h": 70
      },
      "properties": {
        "title": "0x20 · 压力",
        "value": "—",
        "unit": "bar",
        "decimals": "2",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "收到的压力"
      }
    },
    {
      "id": "state",
      "type": "NumericDisplay",
      "geometry": {
        "x": 294,
        "y": 437,
        "w": 258,
        "h": 70
      },
      "properties": {
        "title": "0x20 · 状态",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20,
        "displayStyle": "状态徽标",
        "displayFormat": "枚举",
        "textList": "0=停止|#64748b\n1=运行|#107c10\n2=故障|#d13438"
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "收到的状态码"
      }
    },
    {
      "id": "sendA",
      "type": "PushButton",
      "geometry": {
        "x": 568,
        "y": 448,
        "w": 170,
        "h": 36
      },
      "properties": {
        "text": "发转速 · 0x10",
        "commandMode": "HEX",
        "commandTargetId": "device",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "10 {rpm}",
        "commandInputs": [
          {
            "variable": "rpm",
            "inputId": "rpmInput",
            "dataType": "uint16"
          }
        ],
        "byteOrder": "小端(LE)",
        "buttonStyle": "强调"
      }
    },
    {
      "id": "sendB",
      "type": "PushButton",
      "geometry": {
        "x": 747,
        "y": 448,
        "w": 170,
        "h": 36
      },
      "properties": {
        "text": "发压力状态 · 0x20",
        "commandMode": "HEX",
        "commandTargetId": "device",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "20 {pressure} {state}",
        "commandInputs": [
          {
            "variable": "pressure",
            "inputId": "pressureInput",
            "dataType": "uint16"
          },
          {
            "variable": "state",
            "inputId": "stateInput",
            "dataType": "uint8"
          }
        ]
      }
    },
    {
      "id": "sendC",
      "type": "PushButton",
      "geometry": {
        "x": 926,
        "y": 448,
        "w": 170,
        "h": 36
      },
      "properties": {
        "text": "发温度 · 0x30",
        "commandMode": "HEX",
        "commandTargetId": "device",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "30 {temperature}",
        "commandInputs": [
          {
            "variable": "temperature",
            "inputId": "temperatureInput",
            "dataType": "int16"
          }
        ]
      }
    },
    {
      "id": "sendBatch",
      "type": "PushButton",
      "geometry": {
        "x": 568,
        "y": 492,
        "w": 258,
        "h": 36
      },
      "properties": {
        "text": "发固定三帧 · 验证粘包",
        "commandMode": "HEX",
        "commandTargetId": "device",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "command": "AA 55 04 20 01 77 01 E4 AA 55 03 30 00 C3 9C AA 55 03 10 FC 08 48",
        "dataType": "HEX字符串"
      }
    },
    {
      "id": "sendBad",
      "type": "PushButton",
      "geometry": {
        "x": 568,
        "y": 570,
        "w": 170,
        "h": 36
      },
      "properties": {
        "text": "坏 CRC",
        "commandMode": "HEX",
        "commandTargetId": "device",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "command": "AA 55 03 10 E7 03 B8",
        "dataType": "HEX字符串"
      }
    },
    {
      "id": "sendPart1",
      "type": "PushButton",
      "geometry": {
        "x": 747,
        "y": 570,
        "w": 170,
        "h": 36
      },
      "properties": {
        "text": "发上半帧",
        "command": "AA 55 03 10",
        "commandMode": "HEX",
        "commandTargetId": "device",
        "dataType": "HEX字符串"
      }
    },
    {
      "id": "sendPart2",
      "type": "PushButton",
      "geometry": {
        "x": 926,
        "y": 570,
        "w": 170,
        "h": 36
      },
      "properties": {
        "text": "补齐下半帧",
        "command": "DC 05 C5",
        "commandMode": "HEX",
        "commandTargetId": "device",
        "dataType": "HEX字符串"
      }
    },
    {
      "id": "hmiLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 24,
        "y": 621,
        "w": 528,
        "h": 188
      },
      "properties": {
        "title": "上位机收发报文",
        "sourceCardId": "hmi"
      }
    },
    {
      "id": "deviceLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 568,
        "y": 621,
        "w": 528,
        "h": 188
      },
      "properties": {
        "title": "模拟设备收发报文",
        "sourceCardId": "device"
      }
    },
    {
      "id": "receivedValues",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 329,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "接收结果 · 工程数据点",
        "fontSize": 13,
        "bold": true
      }
    },
    {
      "id": "sendValues",
      "type": "Label",
      "geometry": {
        "x": 568,
        "y": 329,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "发送值 · 模拟设备",
        "fontSize": 13,
        "bold": true
      }
    },
    {
      "id": "diagnosticSamples",
      "type": "Label",
      "geometry": {
        "x": 568,
        "y": 541,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "故障与重组 · 固定样例",
        "fontSize": 13,
        "bold": true
      }
    },
    {
      "id": "valueScales",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 530,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "温度原码 × 0.1 得到 °C，压力原码 × 0.01 得到 bar。",
        "fontSize": 13
      }
    },
    {
      "id": "monitorTip",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 557,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "工具栏「工程数据监视」可查看数值、来源和状态。",
        "fontSize": 13
      }
    },
    {
      "id": "rpmInput",
      "type": "LineEdit",
      "geometry": {
        "x": 568,
        "y": 358,
        "w": 258,
        "h": 36
      },
      "properties": {
        "title": "转速 (rpm)",
        "text": "1500",
        "inputOnly": true
      }
    },
    {
      "id": "temperatureInput",
      "type": "LineEdit",
      "geometry": {
        "x": 838,
        "y": 358,
        "w": 258,
        "h": 36
      },
      "properties": {
        "title": "温度原码",
        "text": "-125",
        "inputOnly": true
      }
    },
    {
      "id": "pressureInput",
      "type": "LineEdit",
      "geometry": {
        "x": 568,
        "y": 401,
        "w": 258,
        "h": 36
      },
      "properties": {
        "title": "压力原码",
        "text": "250",
        "inputOnly": true
      }
    },
    {
      "id": "stateInput",
      "type": "LineEdit",
      "geometry": {
        "x": 838,
        "y": 401,
        "w": 258,
        "h": 36
      },
      "properties": {
        "title": "状态（0停 / 1运行 / 2故障）",
        "text": "2",
        "inputOnly": true
      }
    }
  ],
  "frameTemplates": {
    "sample-frame": {
      "name": "共用长度与 CRC8",
      "parser": "hex",
      "parserConfig": {
        "header": "AA 55",
        "footer": "",
        "lengthOffset": 2,
        "lengthSize": 1,
        "lengthCovers": "数据",
        "checksum": "CRC8",
        "checksumStart": 2,
        "fields": [
          [
            "length",
            0,
            1,
            "uint8"
          ],
          [
            "cmd",
            1,
            1,
            "uint8"
          ]
        ]
      },
      "sample": "AA 55 03 10 DC 05 C5"
    }
  },
  "logic": {
    "points": [
      {
        "name": "收到的转速",
        "unit": "rpm",
        "binding": {
          "parseMode": "HEX字节提取",
          "sourceCardId": "hmi",
          "frameHeader": "AA 55 03 10",
          "byteOffset": 0,
          "dataType": "uint16",
          "byteOrder": "小端(LE)"
        }
      },
      {
        "name": "收到的温度",
        "unit": "°C",
        "binding": {
          "parseMode": "HEX字节提取",
          "sourceCardId": "hmi",
          "frameHeader": "AA 55 03 30",
          "byteOffset": 0,
          "dataType": "int16",
          "byteOrder": "大端(BE)",
          "expression": "value * 0.1"
        }
      },
      {
        "name": "收到的压力",
        "unit": "bar",
        "binding": {
          "parseMode": "HEX字节提取",
          "sourceCardId": "hmi",
          "frameHeader": "AA 55 04 20",
          "byteOffset": 0,
          "dataType": "uint16",
          "byteOrder": "大端(BE)",
          "expression": "value * 0.01"
        }
      },
      {
        "name": "收到的状态码",
        "binding": {
          "parseMode": "HEX字节提取",
          "sourceCardId": "hmi",
          "frameHeader": "AA 55 04 20",
          "byteOffset": 2,
          "dataType": "uint8",
          "byteOrder": "大端(BE)"
        }
      }
    ]
  }
}
