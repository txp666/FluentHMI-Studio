{
  "version": "1.3",
  "appName": "17.2 UDP嵌套JSON",
  "canvas": {
    "width": 1120,
    "height": 740,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.2 UDP嵌套JSON",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "连接两张 UDP 卡。就绪回车只发一个布尔值，按钮发完整 JSON。可周期采样，再从设备回送读数。",
        "fontSize": 13
      }
    },
    {
      "id": "hmi",
      "type": "UdpConfigCard",
      "geometry": {
        "x": 24,
        "y": 94,
        "w": 528,
        "h": 190
      },
      "properties": {
        "title": "上位机 · UDP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39175,
        "defaultLocalPort": 39174,
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "device",
      "type": "UdpConfigCard",
      "geometry": {
        "x": 568,
        "y": 94,
        "w": 528,
        "h": 190
      },
      "properties": {
        "title": "模拟设备 · UDP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39174,
        "defaultLocalPort": 39175,
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "rpmInput",
      "type": "LineEdit",
      "geometry": {
        "x": 24,
        "y": 298,
        "w": 165,
        "h": 36
      },
      "properties": {
        "title": "转速",
        "text": "1500",
        "inputOnly": true
      }
    },
    {
      "id": "tempInput",
      "type": "LineEdit",
      "geometry": {
        "x": 204,
        "y": 298,
        "w": 165,
        "h": 36
      },
      "properties": {
        "title": "末项温度",
        "text": "24.25",
        "inputOnly": true
      }
    },
    {
      "id": "readyInput",
      "type": "LineEdit",
      "geometry": {
        "x": 384,
        "y": 298,
        "w": 168,
        "h": 36
      },
      "properties": {
        "title": "就绪（回车）",
        "text": "true",
        "inputOnly": false,
        "commandMode": "JSON",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "{\"telemetry\":{\"ready\":{value}}}"
      }
    },
    {
      "id": "sendJson",
      "type": "PushButton",
      "geometry": {
        "x": 24,
        "y": 346,
        "w": 176,
        "h": 36
      },
      "properties": {
        "text": "发送采样",
        "commandMode": "JSON",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "jsonUseInputs": true,
        "commandTemplate": "{\"station\":\"泵站A\",\"telemetry\":{\"rpm\":{rpm},\"samples\":[23.5,{temp}],\"ready\":{ready}}}",
        "commandInputs": [
          {
            "variable": "rpm",
            "inputId": "rpmInput"
          },
          {
            "variable": "temp",
            "inputId": "tempInput"
          },
          {
            "variable": "ready",
            "inputId": "readyInput"
          }
        ]
      }
    },
    {
      "id": "cycleJson",
      "type": "PushButton",
      "geometry": {
        "x": 212,
        "y": 346,
        "w": 205,
        "h": 36
      },
      "properties": {
        "text": "周期采样 · 1000 ms",
        "commandMode": "JSON",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "jsonUseInputs": true,
        "commandTemplate": "{\"station\":\"泵站A\",\"telemetry\":{\"rpm\":{rpm},\"samples\":[23.5,{temp}],\"ready\":{ready}}}",
        "commandInputs": [
          {
            "variable": "rpm",
            "inputId": "rpmInput"
          },
          {
            "variable": "temp",
            "inputId": "tempInput"
          },
          {
            "variable": "ready",
            "inputId": "readyInput"
          }
        ],
        "sendIntervalMs": 1000,
        "buttonStyle": "描边"
      }
    },
    {
      "id": "replyJson",
      "type": "PushButton",
      "geometry": {
        "x": 824,
        "y": 298,
        "w": 272,
        "h": 36
      },
      "properties": {
        "text": "回送设备读数",
        "commandMode": "JSON",
        "commandTargetId": "device",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "jsonUseInputs": true,
        "commandTemplate": "{\"ack\":true,\"readback\":[{rpm},{temp}]}",
        "commandInputs": [
          {
            "variable": "rpm",
            "inputId": "@data:设备转速"
          },
          {
            "variable": "temp",
            "inputId": "@data:设备末项温度"
          }
        ]
      }
    },
    {
      "id": "stationCaption",
      "type": "Label",
      "geometry": {
        "x": 568,
        "y": 349,
        "w": 220,
        "h": 24
      },
      "properties": {
        "text": "站点字符串",
        "fontSize": 13,
        "bold": true
      }
    },
    {
      "id": "station",
      "type": "Label",
      "geometry": {
        "x": 568,
        "y": 375,
        "w": 220,
        "h": 32
      },
      "properties": {
        "text": "—",
        "fontSize": 17
      },
      "binding": {
        "parseMode": "JSON路径",
        "sourceCardId": "device",
        "jsonPath": "station"
      }
    },
    {
      "id": "readyCaption",
      "type": "Label",
      "geometry": {
        "x": 836,
        "y": 349,
        "w": 220,
        "h": 24
      },
      "properties": {
        "text": "布尔就绪",
        "fontSize": 13,
        "bold": true
      }
    },
    {
      "id": "ready",
      "type": "Label",
      "geometry": {
        "x": 836,
        "y": 375,
        "w": 220,
        "h": 32
      },
      "properties": {
        "text": "—",
        "fontSize": 17
      },
      "binding": {
        "parseMode": "JSON路径",
        "sourceCardId": "device",
        "jsonPath": "telemetry.ready"
      }
    },
    {
      "id": "devTemp",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 414,
        "w": 254,
        "h": 56
      },
      "properties": {
        "title": "数组末项",
        "value": "—",
        "unit": "°C",
        "decimals": "2",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "设备末项温度"
      }
    },
    {
      "id": "devRpm",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 414,
        "w": 260,
        "h": 56
      },
      "properties": {
        "title": "嵌套转速",
        "value": "—",
        "unit": "rpm",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "设备转速"
      }
    },
    {
      "id": "hmiRpm",
      "type": "NumericDisplay",
      "geometry": {
        "x": 24,
        "y": 414,
        "w": 254,
        "h": 56
      },
      "properties": {
        "title": "回送数组第 0 项",
        "value": "—",
        "unit": "rpm",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "JSON路径",
        "sourceCardId": "hmi",
        "jsonPath": "readback.0"
      }
    },
    {
      "id": "hmiTemp",
      "type": "NumericDisplay",
      "geometry": {
        "x": 290,
        "y": 414,
        "w": 262,
        "h": 56
      },
      "properties": {
        "title": "回送数组第 1 项",
        "value": "—",
        "unit": "°C",
        "decimals": "2",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "JSON路径",
        "sourceCardId": "hmi",
        "jsonPath": "readback.1"
      }
    },
    {
      "id": "hmiLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 24,
        "y": 482,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "上位机收发报文",
        "sourceCardId": "hmi"
      }
    },
    {
      "id": "deviceLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 568,
        "y": 482,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "模拟设备收发报文",
        "sourceCardId": "device"
      }
    }
  ],
  "frameTemplates": {
    "sample-frame": {
      "name": "UTF-8 JSON 对象",
      "parser": "line",
      "parserConfig": {
        "encoding": "utf-8",
        "terminator": "\n"
      },
      "sample": "{\"station\":\"泵站A\",\"telemetry\":{\"rpm\":1500,\"samples\":[23.5,24.25],\"ready\":true}}"
    }
  },
  "logic": {
    "points": [
      {
        "name": "设备末项温度",
        "binding": {
          "parseMode": "JSON路径",
          "sourceCardId": "device",
          "jsonPath": "telemetry.samples.-1"
        }
      },
      {
        "name": "设备转速",
        "binding": {
          "parseMode": "JSON路径",
          "sourceCardId": "device",
          "jsonPath": "telemetry.rpm"
        }
      }
    ]
  }
}
