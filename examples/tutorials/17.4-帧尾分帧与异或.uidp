{
  "version": "1.3",
  "appName": "17.4 帧尾分帧与异或",
  "canvas": {
    "width": 1120,
    "height": 768,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.4 帧尾分帧与异或",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "1. 选左侧「预览运行」，点「运行预览」。先连接右侧模拟设备，再连接左侧上位机。",
        "fontSize": 13
      }
    },
    {
      "id": "lessonAction",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 84,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "2. 用左侧 HEX 载荷发短帧。改「扩展值」后发长帧，右侧会多出这个读数。",
        "fontSize": 13
      }
    },
    {
      "id": "hmi",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 24,
        "y": 122,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "上位机 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39177,
        "defaultMode": "客户端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "device",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 568,
        "y": 122,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "模拟设备 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39177,
        "defaultMode": "服务端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "rawInput",
      "type": "LineEdit",
      "geometry": {
        "x": 24,
        "y": 326,
        "w": 528,
        "h": 36
      },
      "properties": {
        "title": "HEX 载荷（回车）",
        "text": "21 41 42 43 DE AD",
        "inputOnly": false,
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "dataType": "HEX字符串"
      }
    },
    {
      "id": "sendRaw",
      "type": "PushButton",
      "geometry": {
        "x": 24,
        "y": 464,
        "w": 170,
        "h": 36
      },
      "properties": {
        "text": "发送输入载荷",
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "{payload}",
        "commandInputs": [
          {
            "inputId": "rawInput",
            "variable": "payload",
            "dataType": "HEX字符串"
          }
        ],
        "buttonStyle": "强调"
      }
    },
    {
      "id": "extraInput",
      "type": "LineEdit",
      "geometry": {
        "x": 24,
        "y": 420,
        "w": 528,
        "h": 36
      },
      "properties": {
        "title": "扩展值（长帧）",
        "text": "1000",
        "inputOnly": true
      }
    },
    {
      "id": "sendLong",
      "type": "PushButton",
      "geometry": {
        "x": 204,
        "y": 464,
        "w": 214,
        "h": 36
      },
      "properties": {
        "text": "发送带扩展值的帧",
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "{payload} {extra}",
        "commandInputs": [
          {
            "variable": "payload",
            "inputId": "rawInput",
            "dataType": "HEX字符串"
          },
          {
            "variable": "extra",
            "inputId": "extraInput",
            "dataType": "uint16"
          }
        ]
      }
    },
    {
      "id": "tagCaption",
      "type": "Label",
      "geometry": {
        "x": 568,
        "y": 330,
        "w": 220,
        "h": 24
      },
      "properties": {
        "text": "ASCII 标识",
        "fontSize": 13,
        "bold": true
      }
    },
    {
      "id": "tag",
      "type": "Label",
      "geometry": {
        "x": 568,
        "y": 356,
        "w": 220,
        "h": 32
      },
      "properties": {
        "text": "—",
        "fontSize": 17
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "设备标签"
      }
    },
    {
      "id": "rawCaption",
      "type": "Label",
      "geometry": {
        "x": 836,
        "y": 330,
        "w": 220,
        "h": 24
      },
      "properties": {
        "text": "两字节 HEX 字段",
        "fontSize": 13,
        "bold": true
      }
    },
    {
      "id": "raw",
      "type": "Label",
      "geometry": {
        "x": 836,
        "y": 356,
        "w": 220,
        "h": 32
      },
      "properties": {
        "text": "—",
        "fontSize": 17
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "设备 HEX 字段"
      }
    },
    {
      "id": "cmd",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 416,
        "w": 254,
        "h": 76
      },
      "properties": {
        "title": "命令",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "命令字"
      }
    },
    {
      "id": "extra",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 416,
        "w": 260,
        "h": 76
      },
      "properties": {
        "title": "最近长帧的扩展值",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "最近长帧扩展值"
      }
    },
    {
      "id": "hmiLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 24,
        "y": 510,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "上位机收发报文",
        "sourceCardId": "hmi"
      }
    },
    {
      "id": "deviceLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 568,
        "y": 510,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "模拟设备收发报文",
        "sourceCardId": "device"
      }
    }
  ],
  "frameTemplates": {
    "sample-frame": {
      "name": "帧尾分帧",
      "parser": "hex",
      "parserConfig": {
        "header": "7E",
        "footer": "0D 0A",
        "checksum": "异或",
        "checksumStart": 1,
        "fields": [
          [
            "cmd",
            0,
            1,
            "uint8"
          ],
          [
            "tag",
            1,
            3,
            "ASCII"
          ],
          [
            "raw",
            4,
            2,
            "HEX"
          ],
          [
            "extra",
            6,
            2,
            "uint16",
            "大端(BE)"
          ]
        ]
      },
      "sample": "7E 21 41 42 43 DE AD 12 0D 0A"
    }
  },
  "logic": {
    "points": [
      {
        "name": "设备标签",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "tag"
        }
      },
      {
        "name": "设备 HEX 字段",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "raw"
        }
      },
      {
        "name": "命令字",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "cmd"
        }
      },
      {
        "name": "最近长帧扩展值",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "extra"
        }
      }
    ]
  }
}
