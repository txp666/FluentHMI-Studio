{
  "version": "1.3",
  "appName": "17.4 帧尾分帧与异或",
  "canvas": {
    "width": 1120,
    "height": 740,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.4 帧尾分帧与异或",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "先连右侧，再连左侧。HEX 载荷可回车单发。再发送长帧，对比相同帧尾下的两种长度。",
        "fontSize": 13
      }
    },
    {
      "id": "hmi",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 24,
        "y": 94,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "上位机 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39177,
        "defaultMode": "客户端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "device",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 568,
        "y": 94,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "模拟设备 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39177,
        "defaultMode": "服务端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "rawInput",
      "type": "LineEdit",
      "geometry": {
        "x": 24,
        "y": 298,
        "w": 528,
        "h": 36
      },
      "properties": {
        "title": "HEX 载荷（回车）",
        "text": "21 41 42 43 DE AD",
        "inputOnly": false,
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "dataType": "HEX字符串"
      }
    },
    {
      "id": "sendRaw",
      "type": "PushButton",
      "geometry": {
        "x": 24,
        "y": 346,
        "w": 170,
        "h": 36
      },
      "properties": {
        "text": "发送输入载荷",
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "{payload}",
        "commandInputs": [
          {
            "inputId": "rawInput",
            "variable": "payload",
            "dataType": "HEX字符串"
          }
        ]
      }
    },
    {
      "id": "sendLong",
      "type": "PushButton",
      "geometry": {
        "x": 204,
        "y": 346,
        "w": 214,
        "h": 36
      },
      "properties": {
        "text": "发送带扩展值的帧",
        "commandMode": "HEX",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "command": "22 58 59 5A 12 34 03 E8",
        "dataType": "HEX字符串"
      }
    },
    {
      "id": "tagCaption",
      "type": "Label",
      "geometry": {
        "x": 568,
        "y": 302,
        "w": 220,
        "h": 24
      },
      "properties": {
        "text": "ASCII 标识",
        "fontSize": 13,
        "bold": true
      }
    },
    {
      "id": "tag",
      "type": "Label",
      "geometry": {
        "x": 568,
        "y": 328,
        "w": 220,
        "h": 32
      },
      "properties": {
        "text": "—",
        "fontSize": 17
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "device",
        "key": "tag"
      }
    },
    {
      "id": "rawCaption",
      "type": "Label",
      "geometry": {
        "x": 836,
        "y": 302,
        "w": 220,
        "h": 24
      },
      "properties": {
        "text": "两字节 HEX 字段",
        "fontSize": 13,
        "bold": true
      }
    },
    {
      "id": "raw",
      "type": "Label",
      "geometry": {
        "x": 836,
        "y": 328,
        "w": 220,
        "h": 32
      },
      "properties": {
        "text": "—",
        "fontSize": 17
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "device",
        "key": "raw"
      }
    },
    {
      "id": "cmd",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 388,
        "w": 254,
        "h": 76
      },
      "properties": {
        "title": "命令",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "device",
        "key": "cmd"
      }
    },
    {
      "id": "extra",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 388,
        "w": 260,
        "h": 76
      },
      "properties": {
        "title": "最近长帧的扩展值",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "device",
        "key": "extra"
      }
    },
    {
      "id": "hmiLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 24,
        "y": 482,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "上位机收发报文",
        "sourceCardId": "hmi"
      }
    },
    {
      "id": "deviceLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 568,
        "y": 482,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "模拟设备收发报文",
        "sourceCardId": "device"
      }
    }
  ],
  "frameTemplates": {
    "sample-frame": {
      "name": "帧尾分帧",
      "parser": "hex",
      "parserConfig": {
        "header": "7E",
        "footer": "0D 0A",
        "checksum": "异或",
        "checksumStart": 1,
        "fields": [
          [
            "cmd",
            0,
            1,
            "uint8"
          ],
          [
            "tag",
            1,
            3,
            "ASCII"
          ],
          [
            "raw",
            4,
            2,
            "HEX"
          ],
          [
            "extra",
            6,
            2,
            "uint16",
            "大端(BE)"
          ]
        ]
      },
      "sample": "7E 21 41 42 43 DE AD 12 0D 0A"
    }
  }
}
