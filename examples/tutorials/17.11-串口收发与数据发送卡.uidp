{
  "version": "1.3",
  "appName": "17.11 串口收发与数据发送卡",
  "canvas": {
    "width": 1120,
    "height": 844,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.11 串口收发与数据发送卡",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "1. 选左侧「预览运行」，点「运行预览」。分别连接左侧虚拟串口 A 和右侧虚拟串口 B。",
        "fontSize": 13
      }
    },
    {
      "id": "lessonAction",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 84,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "2. 左侧点「按字段发送…」，填序号 1 和采样 -100。右侧查看接收读数。",
        "fontSize": 13
      }
    },
    {
      "id": "hmi",
      "type": "SerialConfigCard",
      "geometry": {
        "x": 24,
        "y": 122,
        "w": 528,
        "h": 242
      },
      "properties": {
        "title": "上位机 · 串口 A",
        "defaultPortName": "virtual:A",
        "receiveFrameTemplateId": "serial-frame",
        "defaultBaud": "115200",
        "defaultDatabits": "8",
        "defaultParity": "None",
        "defaultStopbits": "1",
        "defaultFlow": "无"
      }
    },
    {
      "id": "device",
      "type": "SerialConfigCard",
      "geometry": {
        "x": 568,
        "y": 122,
        "w": 528,
        "h": 242
      },
      "properties": {
        "title": "模拟设备 · 串口 B",
        "defaultPortName": "virtual:B",
        "receiveFrameTemplateId": "serial-frame",
        "defaultBaud": "115200",
        "defaultDatabits": "8",
        "defaultParity": "None",
        "defaultStopbits": "1",
        "defaultFlow": "无"
      }
    },
    {
      "id": "singleSerialHint",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 370,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "按字段填序号 1、采样 -100，或输入 HEX 载荷 01 FF 9C。",
        "fontSize": 13
      }
    },
    {
      "id": "singleSerial",
      "type": "DataSendCard",
      "geometry": {
        "x": 24,
        "y": 400,
        "w": 528,
        "h": 138
      },
      "properties": {
        "title": "A → B · 单次发送",
        "commandMode": "HEX",
        "sendFrameTemplateId": "serial-frame",
        "commandTargetId": "hmi",
        "sendIntervalMs": 0,
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true
      }
    },
    {
      "id": "cycleSerialHint",
      "type": "Label",
      "geometry": {
        "x": 568,
        "y": 370,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "按字段填序号 2、采样 250，或输入 HEX 载荷 02 00 FA。",
        "fontSize": 13
      }
    },
    {
      "id": "cycleSerial",
      "type": "DataSendCard",
      "geometry": {
        "x": 568,
        "y": 400,
        "w": 528,
        "h": 138
      },
      "properties": {
        "title": "B → A · 周期发送 700 ms",
        "commandMode": "HEX",
        "sendFrameTemplateId": "serial-frame",
        "commandTargetId": "device",
        "sendIntervalMs": 700,
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true
      }
    },
    {
      "id": "hmiSequence",
      "type": "NumericDisplay",
      "geometry": {
        "x": 24,
        "y": 555,
        "w": 258,
        "h": 64
      },
      "properties": {
        "title": "A 收到的序号",
        "value": "—",
        "decimals": "0",
        "fontSize": 20,
        "unit": ""
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "串口 A 收到的序号"
      }
    },
    {
      "id": "hmiSample",
      "type": "NumericDisplay",
      "geometry": {
        "x": 294,
        "y": 555,
        "w": 258,
        "h": 64
      },
      "properties": {
        "title": "A 收到的采样",
        "value": "—",
        "decimals": "0",
        "fontSize": 20,
        "unit": ""
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "串口 A 收到的采样"
      }
    },
    {
      "id": "deviceSequence",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 555,
        "w": 258,
        "h": 64
      },
      "properties": {
        "title": "B 收到的序号",
        "value": "—",
        "decimals": "0",
        "fontSize": 20,
        "unit": ""
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "串口 B 收到的序号"
      }
    },
    {
      "id": "deviceSample",
      "type": "NumericDisplay",
      "geometry": {
        "x": 838,
        "y": 555,
        "w": 258,
        "h": 64
      },
      "properties": {
        "title": "B 收到的采样",
        "value": "—",
        "decimals": "0",
        "fontSize": 20,
        "unit": ""
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "串口 B 收到的采样"
      }
    },
    {
      "id": "hmiLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 24,
        "y": 635,
        "w": 528,
        "h": 184
      },
      "properties": {
        "title": "上位机收发报文",
        "sourceCardId": "hmi"
      }
    },
    {
      "id": "deviceLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 568,
        "y": 635,
        "w": 528,
        "h": 184
      },
      "properties": {
        "title": "模拟设备收发报文",
        "sourceCardId": "device"
      }
    }
  ],
  "frameTemplates": {
    "serial-frame": {
      "name": "串口大端长度帧",
      "parser": "hex",
      "parserConfig": {
        "header": "D5 5D",
        "footer": "0D 0A",
        "lengthOffset": 2,
        "lengthSize": 2,
        "lengthEndian": "大端(BE)",
        "lengthCovers": "长度字段之后",
        "checksum": "无",
        "fields": [
          [
            "序号",
            2,
            1,
            "uint8"
          ],
          [
            "采样",
            3,
            2,
            "int16",
            "大端(BE)"
          ]
        ],
        "sendRequiredFields": [
          "序号",
          "采样"
        ]
      },
      "sample": "D5 5D 00 05 01 FF 9C 0D 0A"
    }
  },
  "logic": {
    "points": [
      {
        "name": "串口 A 收到的序号",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "hmi",
          "key": "序号"
        }
      },
      {
        "name": "串口 A 收到的采样",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "hmi",
          "key": "采样"
        }
      },
      {
        "name": "串口 B 收到的序号",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "序号"
        }
      },
      {
        "name": "串口 B 收到的采样",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "采样"
        }
      }
    ]
  }
}
