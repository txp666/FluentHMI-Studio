{
  "version": "1.3",
  "appName": "17.11 串口收发与数据发送卡",
  "canvas": {
    "width": 1120,
    "height": 816,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.11 串口收发与数据发送卡",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "两张卡已选虚拟串口 A 和 B，分别点连接。按卡片上方给出的载荷，试单发和周期发送。",
        "fontSize": 13
      }
    },
    {
      "id": "hmi",
      "type": "SerialConfigCard",
      "geometry": {
        "x": 24,
        "y": 94,
        "w": 528,
        "h": 242
      },
      "properties": {
        "title": "上位机 · 串口 A",
        "defaultPortName": "virtual:A",
        "receiveFrameTemplateId": "serial-frame",
        "defaultBaud": "115200",
        "defaultDatabits": "8",
        "defaultParity": "None",
        "defaultStopbits": "1",
        "defaultFlow": "无"
      }
    },
    {
      "id": "device",
      "type": "SerialConfigCard",
      "geometry": {
        "x": 568,
        "y": 94,
        "w": 528,
        "h": 242
      },
      "properties": {
        "title": "模拟设备 · 串口 B",
        "defaultPortName": "virtual:B",
        "receiveFrameTemplateId": "serial-frame",
        "defaultBaud": "115200",
        "defaultDatabits": "8",
        "defaultParity": "None",
        "defaultStopbits": "1",
        "defaultFlow": "无"
      }
    },
    {
      "id": "singleSerialHint",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 342,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "载荷输入 01 FF 9C，回车或点发送",
        "fontSize": 13
      }
    },
    {
      "id": "singleSerial",
      "type": "DataSendCard",
      "geometry": {
        "x": 24,
        "y": 372,
        "w": 528,
        "h": 138
      },
      "properties": {
        "title": "单发 HEX 载荷",
        "commandMode": "HEX",
        "sendFrameTemplateId": "serial-frame",
        "commandTargetId": "hmi",
        "sendIntervalMs": 0,
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true
      }
    },
    {
      "id": "cycleSerialHint",
      "type": "Label",
      "geometry": {
        "x": 568,
        "y": 342,
        "w": 528,
        "h": 24
      },
      "properties": {
        "text": "载荷输入 02 00 FA，启动后可直接改值",
        "fontSize": 13
      }
    },
    {
      "id": "cycleSerial",
      "type": "DataSendCard",
      "geometry": {
        "x": 568,
        "y": 372,
        "w": 528,
        "h": 138
      },
      "properties": {
        "title": "周期 HEX 载荷 · 700 ms",
        "commandMode": "HEX",
        "sendFrameTemplateId": "serial-frame",
        "commandTargetId": "device",
        "sendIntervalMs": 700,
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true
      }
    },
    {
      "id": "hmiSequence",
      "type": "NumericDisplay",
      "geometry": {
        "x": 24,
        "y": 527,
        "w": 258,
        "h": 64
      },
      "properties": {
        "title": "收到的序号",
        "value": "—",
        "decimals": "0",
        "fontSize": 20,
        "unit": ""
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "hmi",
        "key": "sequence"
      }
    },
    {
      "id": "hmiSample",
      "type": "NumericDisplay",
      "geometry": {
        "x": 294,
        "y": 527,
        "w": 258,
        "h": 64
      },
      "properties": {
        "title": "收到的采样值",
        "value": "—",
        "decimals": "0",
        "fontSize": 20,
        "unit": ""
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "hmi",
        "key": "sample"
      }
    },
    {
      "id": "deviceSequence",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 527,
        "w": 258,
        "h": 64
      },
      "properties": {
        "title": "收到的序号",
        "value": "—",
        "decimals": "0",
        "fontSize": 20,
        "unit": ""
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "device",
        "key": "sequence"
      }
    },
    {
      "id": "deviceSample",
      "type": "NumericDisplay",
      "geometry": {
        "x": 838,
        "y": 527,
        "w": 258,
        "h": 64
      },
      "properties": {
        "title": "收到的采样值",
        "value": "—",
        "decimals": "0",
        "fontSize": 20,
        "unit": ""
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "device",
        "key": "sample"
      }
    },
    {
      "id": "hmiLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 24,
        "y": 607,
        "w": 528,
        "h": 184
      },
      "properties": {
        "title": "上位机收发报文",
        "sourceCardId": "hmi"
      }
    },
    {
      "id": "deviceLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 568,
        "y": 607,
        "w": 528,
        "h": 184
      },
      "properties": {
        "title": "模拟设备收发报文",
        "sourceCardId": "device"
      }
    }
  ],
  "frameTemplates": {
    "serial-frame": {
      "name": "串口大端长度帧",
      "parser": "hex",
      "parserConfig": {
        "header": "D5 5D",
        "footer": "0D 0A",
        "lengthOffset": 2,
        "lengthSize": 2,
        "lengthEndian": "大端(BE)",
        "lengthCovers": "长度字段之后",
        "checksum": "无",
        "fields": [
          [
            "sequence",
            2,
            1,
            "uint8"
          ],
          [
            "sample",
            3,
            2,
            "int16",
            "大端(BE)"
          ]
        ]
      },
      "sample": "D5 5D 00 05 01 FF 9C 0D 0A"
    }
  }
}
