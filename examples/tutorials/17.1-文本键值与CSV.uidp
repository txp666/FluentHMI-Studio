{
  "version": "1.3",
  "appName": "17.1 文本键值与CSV",
  "canvas": {
    "width": 1120,
    "height": 762,
    "gridSize": 10
  },
  "serial": {
    "parser": "line"
  },
  "widgets": [
    {
      "id": "lessonTitle",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 16,
        "w": 1072,
        "h": 38
      },
      "properties": {
        "text": "17.1 文本键值与CSV",
        "fontSize": 24,
        "bold": true
      }
    },
    {
      "id": "lessonSteps",
      "type": "Label",
      "geometry": {
        "x": 24,
        "y": 60,
        "w": 1072,
        "h": 24
      },
      "properties": {
        "text": "先连接右侧，再连接左侧。转速回车只发转速。用按钮发多项键值或 CSV，两种周期可同时运行。",
        "fontSize": 13
      }
    },
    {
      "id": "hmi",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 24,
        "y": 94,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "上位机 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39173,
        "defaultMode": "客户端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "device",
      "type": "TcpConfigCard",
      "geometry": {
        "x": 568,
        "y": 94,
        "w": 528,
        "h": 200
      },
      "properties": {
        "title": "模拟设备 · TCP",
        "defaultHost": "127.0.0.1",
        "defaultPort": 39173,
        "defaultMode": "服务端",
        "receiveFrameTemplateId": "sample-frame"
      }
    },
    {
      "id": "rpmInput",
      "type": "LineEdit",
      "geometry": {
        "x": 24,
        "y": 298,
        "w": 168,
        "h": 36
      },
      "properties": {
        "title": "转速（回车）",
        "text": "720",
        "inputOnly": false,
        "commandMode": "文本",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "rpm:{value}"
      }
    },
    {
      "id": "tempInput",
      "type": "LineEdit",
      "geometry": {
        "x": 202,
        "y": 298,
        "w": 168,
        "h": 36
      },
      "properties": {
        "title": "温度 (°C)",
        "text": "-12.5",
        "inputOnly": true
      }
    },
    {
      "id": "stateInput",
      "type": "LineEdit",
      "geometry": {
        "x": 380,
        "y": 298,
        "w": 172,
        "h": 36
      },
      "properties": {
        "title": "状态码 0/1/2",
        "text": "1",
        "inputOnly": true
      }
    },
    {
      "id": "sendKv",
      "type": "PushButton",
      "geometry": {
        "x": 24,
        "y": 346,
        "w": 254,
        "h": 36
      },
      "properties": {
        "text": "发键值命令",
        "commandMode": "文本",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "rpm:{rpm};temperature:{temp};state:{state}",
        "commandInputs": [
          {
            "variable": "rpm",
            "inputId": "rpmInput"
          },
          {
            "variable": "temp",
            "inputId": "tempInput"
          },
          {
            "variable": "state",
            "inputId": "stateInput"
          }
        ]
      }
    },
    {
      "id": "sendCsv",
      "type": "PushButton",
      "geometry": {
        "x": 290,
        "y": 346,
        "w": 262,
        "h": 36
      },
      "properties": {
        "text": "发纯 CSV",
        "commandMode": "文本",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "{rpm};{temp}",
        "commandInputs": [
          {
            "variable": "rpm",
            "inputId": "rpmInput"
          },
          {
            "variable": "temp",
            "inputId": "tempInput"
          }
        ]
      }
    },
    {
      "id": "cycleKv",
      "type": "PushButton",
      "geometry": {
        "x": 24,
        "y": 392,
        "w": 254,
        "h": 36
      },
      "properties": {
        "text": "周期键值 · 500 ms",
        "commandMode": "文本",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "rpm:{rpm};temperature:{temp};state:{state}",
        "commandInputs": [
          {
            "variable": "rpm",
            "inputId": "rpmInput"
          },
          {
            "variable": "temp",
            "inputId": "tempInput"
          },
          {
            "variable": "state",
            "inputId": "stateInput"
          }
        ],
        "sendIntervalMs": 500,
        "buttonStyle": "描边"
      }
    },
    {
      "id": "cycleCsv",
      "type": "PushButton",
      "geometry": {
        "x": 290,
        "y": 392,
        "w": 262,
        "h": 36
      },
      "properties": {
        "text": "周期 CSV · 1200 ms",
        "commandMode": "文本",
        "commandTargetId": "hmi",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "{rpm};{temp}",
        "commandInputs": [
          {
            "variable": "rpm",
            "inputId": "rpmInput"
          },
          {
            "variable": "temp",
            "inputId": "tempInput"
          }
        ],
        "sendIntervalMs": 1200,
        "buttonStyle": "描边"
      }
    },
    {
      "id": "echoStatus",
      "type": "PushButton",
      "geometry": {
        "x": 824,
        "y": 298,
        "w": 272,
        "h": 36
      },
      "properties": {
        "text": "回送转速与温度",
        "commandMode": "文本",
        "commandTargetId": "device",
        "confirmBeforeSend": true,
        "showSendConfirmationDetails": true,
        "sendFrameTemplateId": "sample-frame",
        "commandTemplate": "rpm:{rpm};temperature:{temp}",
        "commandInputs": [
          {
            "variable": "rpm",
            "inputId": "@data:设备目标转速"
          },
          {
            "variable": "temp",
            "inputId": "@data:设备目标温度"
          }
        ]
      }
    },
    {
      "id": "csvCh0",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 354,
        "w": 254,
        "h": 54
      },
      "properties": {
        "title": "CSV ch0 · 转速",
        "value": "—",
        "unit": "rpm",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "device",
        "key": "ch0"
      }
    },
    {
      "id": "csvCh1",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 354,
        "w": 260,
        "h": 54
      },
      "properties": {
        "title": "CSV ch1 · 温度",
        "value": "—",
        "unit": "°C",
        "decimals": "1",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "device",
        "key": "ch1"
      }
    },
    {
      "id": "hmiTemp",
      "type": "NumericDisplay",
      "geometry": {
        "x": 24,
        "y": 440,
        "w": 254,
        "h": 56
      },
      "properties": {
        "title": "回送温度",
        "value": "—",
        "unit": "°C",
        "decimals": "1",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "反馈温度"
      }
    },
    {
      "id": "hmiRpm",
      "type": "NumericDisplay",
      "geometry": {
        "x": 290,
        "y": 440,
        "w": 262,
        "h": 56
      },
      "properties": {
        "title": "回送转速",
        "value": "—",
        "unit": "rpm",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "hmi",
        "key": "rpm"
      }
    },
    {
      "id": "deviceState",
      "type": "NumericDisplay",
      "geometry": {
        "x": 568,
        "y": 440,
        "w": 254,
        "h": 56
      },
      "properties": {
        "title": "状态码",
        "value": "—",
        "unit": "",
        "decimals": "0",
        "fontSize": 20,
        "displayStyle": "状态徽标",
        "displayFormat": "枚举",
        "textList": "0=停机|#64748b\n1=运行|#107c10\n2=故障|#d13438"
      },
      "binding": {
        "parseMode": "键值匹配",
        "sourceCardId": "device",
        "key": "state"
      }
    },
    {
      "id": "deviceRpm",
      "type": "NumericDisplay",
      "geometry": {
        "x": 836,
        "y": 440,
        "w": 260,
        "h": 56
      },
      "properties": {
        "title": "设备收到的目标",
        "value": "—",
        "unit": "rpm",
        "decimals": "0",
        "fontSize": 20
      },
      "binding": {
        "parseMode": "工程数据点",
        "key": "设备目标转速"
      }
    },
    {
      "id": "hmiLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 24,
        "y": 508,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "上位机收发报文",
        "sourceCardId": "hmi"
      }
    },
    {
      "id": "deviceLog",
      "type": "DataRecvCard",
      "geometry": {
        "x": 568,
        "y": 508,
        "w": 528,
        "h": 230
      },
      "properties": {
        "title": "模拟设备收发报文",
        "sourceCardId": "device"
      }
    }
  ],
  "frameTemplates": {
    "sample-frame": {
      "name": "分号键值与 CSV",
      "parser": "line",
      "parserConfig": {
        "separator": ";",
        "kvSeparator": ":",
        "terminator": "\r\n",
        "encoding": "utf-8"
      },
      "sample": "rpm:720;temperature:-12.5;state:1"
    }
  },
  "logic": {
    "points": [
      {
        "name": "设备目标转速",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "rpm"
        }
      },
      {
        "name": "设备目标温度",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "device",
          "key": "temperature"
        }
      },
      {
        "name": "反馈温度",
        "binding": {
          "parseMode": "键值匹配",
          "sourceCardId": "hmi",
          "key": "temperature"
        }
      }
    ]
  }
}
